{
    "name": "posternak/composer-file",
    "description": "The joyful way to programmatically read and edit composer.json and composer.lock in PHP — drop it into any script or automation.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "posternak/json-file": "^1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Posternak\\ComposerFile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andrii Posternak",
            "email": "posternak.andrii1@gmail.com"
        }
    ]
}
