{
    "name": "posternak/composer-file",
    "description": "A thin ergonomic facade over Composer's SDK for everyday composer.json and composer.lock manipulation.",
    "type": "library",
    "require": {
        "composer/composer": "^2.9",
        "posternak/json-file": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Posternak\\ComposerFile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andrii Posternak",
            "email": "posternak.andrii1@gmail.com"
        }
    ]
}
