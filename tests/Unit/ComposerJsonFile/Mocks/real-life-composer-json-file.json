{
  "name": "nova/crm-backend",
  "type": "project",
  "repositories": {
    "billing": {
      "type": "vcs",
      "url": "https://github.com/nova-corp/billing.git"
    },
    "reporting": {
      "type": "vcs",
      "url": "https://github.com/nova-corp/reporting.git"
    },
    "storage-adapter": {
      "type": "vcs",
      "url": "https://github.com/nova-corp/storage-adapter.git"
    }
  },
  "require": {
    "php": "^8.2.0",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "doctrine/orm": "^3.2.1",
    "league/flysystem": "^3.28.0",
    "monolog/monolog": "^3.6.0",
    "nesbot/carbon": "^3.4.0",
    "nova/billing": "^v2.0.3",
    "nova/reporting": "^v1.5.0",
    "nova/storage-adapter": "^v3.1.0",
    "ramsey/uuid": "^4.7.6",
    "symfony/console": "^7.1.0",
    "symfony/http-client": "^7.1.5",
    "symfony/http-foundation": "^7.1.5",
    "symfony/routing": "^7.1.0",
    "symfony/serializer": "^7.1.3",
    "webmozart/assert": "^1.11.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23.1",
    "friendsofphp/php-cs-fixer": "^3.64.0",
    "infection/infection": "^0.29.0",
    "mockery/mockery": "^1.6.12",
    "phpstan/phpstan": "^2.1.0",
    "phpunit/phpunit": "^11.5.3",
    "rector/rector": "^2.0.0",
    "symfony/var-dumper": "^7.1.0"
  },
  "autoload": {
    "psr-4": {
      "Nova\\Crm\\": "src/",
      "Nova\\Crm\\Infrastructure\\": "src/Infrastructure/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nova\\Crm\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src tests",
    "fix": "php-cs-fixer fix src tests",
    "infect": "infection --threads=4",
    "ci": [
      "@analyse",
      "@fix",
      "@test",
      "@infect"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
